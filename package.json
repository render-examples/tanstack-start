{
  "name": "render-tanstack-start",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "quality": "biome ci .",
    "typecheck": "tsc --noEmit",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:error-boundary": "node scripts/check-error-boundary.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install chromium",
    "validate:blueprint": "node scripts/validate-blueprint.mjs"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-start": "1.168.48",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "ajv": "8.20.0",
    "nitro": "3.0.260610-beta",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "yaml": "2.9.0"
  }
}
